{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/qa-copilot/test-case-output.schema.json",
  "title": "QA-Copilot Test Case Generation Output",
  "type": "object",
  "required": [
    "test_cases",
    "priority_rationales",
    "assumptions",
    "open_questions",
    "coverage_notes"
  ],
  "properties": {
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test_case"
      }
    },
    "priority_rationales": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rationale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "coverage_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "covered_by", "gaps"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "covered_by": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "gaps": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "test_case": {
      "type": "object",
      "required": [
        "id",
        "title",
        "preconditions",
        "steps",
        "expected",
        "priority",
        "type"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "preconditions": {"type": "string"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected": {"type": "string", "minLength": 1},
        "priority": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "type": {
          "enum": [
            "functional",
            "negative",
            "boundary",
            "security",
            "usability",
            "compatibility"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
